import os, mimetypes
from datetime import datetime
from PIL import Image
from pypdf import PdfReader
from tkinter import Tk, filedialog

Tk().withdraw()
file_path = filedialog.askopenfilename()

if file_path:
    extension = os.path.splitext(file_path)[1].lower()
    author = "Not available"
    creation_date = datetime.fromtimestamp(
        os.path.getctime(file_path)
    ).strftime("%Y-%m-%d %H:%M:%S")

    if extension in [".jpg", ".jpeg", ".png"]:
        exif_data = Image.open(file_path).getexif()
        author = exif_data.get(315, author)
        creation_date = exif_data.get(36867, creation_date)

    elif extension == ".pdf":
        metadata = PdfReader(file_path).metadata
        if metadata:
            author = metadata.author or author
            creation_date = str(metadata.creation_date or creation_date)

    print("\nFile Name     :", os.path.basename(file_path))
    print("File Type     :", mimetypes.guess_type(file_path)[0] or "Unknown")
    print("Author        :", author)
    print("Creation Date :", creation_date)
    print("File Location :", file_path)
else:
    print("No file selected.")
